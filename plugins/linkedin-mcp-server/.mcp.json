{
  "mcpServers": {
    "linkedin-jobs": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/albertlisage-ux/linkedin-jobs-mcp-server.git",
        "linkedin-jobs-mcp",
        "--transport",
        "stdio"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
